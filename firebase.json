{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": {
    "source": "functions",
    "runtime": "nodejs22"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": "mcp-hosting",
    "rewrites": [
      { "source": "/mcp", "function": { "functionId": "mcp", "region": "australia-southeast1" } },
      { "source": "/.well-known/oauth-protected-resource/mcp", "function": { "functionId": "mcp", "region": "australia-southeast1" } },
      { "source": "/.well-known/oauth-authorization-server", "function": { "functionId": "mcp", "region": "australia-southeast1" } },
      { "source": "/authorize", "function": { "functionId": "mcp", "region": "australia-southeast1" } },
      { "source": "/register", "function": { "functionId": "mcp", "region": "australia-southeast1" } },
      { "source": "/token", "function": { "functionId": "mcp", "region": "australia-southeast1" } },
      { "source": "/oauth/**", "function": { "functionId": "mcp", "region": "australia-southeast1" } }
    ]
  },
  "emulators": {
    "firestore": {
      "host": "127.0.0.1",
      "port": 8080
    },
    "functions": {
      "host": "127.0.0.1",
      "port": 5001
    },
    "auth": {
      "host": "127.0.0.1",
      "port": 9099
    },
    "storage": {
      "host": "127.0.0.1",
      "port": 9199
    },
    "ui": {
      "enabled": false
    }
  }
}
