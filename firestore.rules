rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function membershipPath(memberId) {
      return /databases/$(database)/documents/memberships/$(memberId);
    }

    function householdPath(householdId) {
      return /databases/$(database)/documents/households/$(householdId);
    }

    function rootItemPath(householdId) {
      return /databases/$(database)/documents/households/$(householdId)/items/$(householdId);
    }

    function invitationPath(invitationId) {
      return /databases/$(database)/documents/invitations/$(invitationId);
    }

    function isMember(householdId) {
      return signedIn()
        && get(membershipPath(request.auth.uid)).data.householdId == householdId;
    }

    function isMemberAfter(householdId) {
      return signedIn()
        && getAfter(membershipPath(request.auth.uid)).data.householdId == householdId;
    }

    function isOwner(householdId) {
      return isMember(householdId)
        && get(householdPath(householdId)).data.ownerMemberId == request.auth.uid;
    }

    function validInvitationCreate(invitationId) {
      return request.resource.data.keys().hasOnly([
          'householdId', 'intendedEmail', 'createdAt', 'expiresAt', 'status',
          'replacesInvitationId', 'replacedByInvitationId'
        ])
        && request.resource.data.householdId is string
        && request.resource.data.intendedEmail is string
        && request.resource.data.intendedEmail.matches(
          '^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$'
        )
        && request.resource.data.createdAt is timestamp
        && request.resource.data.createdAt <= request.time
        && request.resource.data.createdAt
          >= request.time - duration.value(5, 'm')
        && request.resource.data.expiresAt
          == request.resource.data.createdAt + duration.value(7, 'd')
        && request.resource.data.status == 'pending'
        && request.resource.data.replacedByInvitationId == null
        && (
          request.resource.data.replacesInvitationId == null
          || validReplacementCreate(invitationId)
        )
        && isOwner(request.resource.data.householdId);
    }

    function validReplacementCreate(invitationId) {
      let previousId = request.resource.data.replacesInvitationId;
      let previous = get(invitationPath(previousId)).data;
      let previousAfter = getAfter(invitationPath(previousId)).data;
      return previousId is string
        && previous.status == 'pending'
        && previous.expiresAt > request.time
        && previous.householdId == request.resource.data.householdId
        && previousAfter.status == 'replaced'
        && previousAfter.replacedByInvitationId == invitationId;
    }

    function validInvitationRevoke() {
      return resource.data.status == 'pending'
        && resource.data.expiresAt > request.time
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status'])
        && request.resource.data.status == 'revoked'
        && isOwner(resource.data.householdId);
    }

    function validInvitationExpire() {
      return resource.data.status == 'pending'
        && resource.data.expiresAt <= request.time
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status'])
        && request.resource.data.status == 'expired'
        && isOwner(resource.data.householdId);
    }

    function validInvitationReplace(invitationId) {
      let replacementId = request.resource.data.replacedByInvitationId;
      let replacement = getAfter(invitationPath(replacementId)).data;
      return resource.data.status == 'pending'
        && resource.data.expiresAt > request.time
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'replacedByInvitationId'])
        && request.resource.data.status == 'replaced'
        && replacementId is string
        && replacement.status == 'pending'
        && replacement.replacesInvitationId == invitationId
        && replacement.householdId == resource.data.householdId
        && isOwner(resource.data.householdId);
    }

    function validName(name) {
      return name is string
        && name.matches('^[^\\s\\p{Z}](.{0,98}[^\\s\\p{Z}])?$');
    }

    function validHouseholdCreate(householdId) {
      return request.resource.data.keys().hasOnly([
          'name', 'ownerMemberId', 'rootItemId', 'createdAt'
        ])
        && validName(request.resource.data.name)
        && request.resource.data.ownerMemberId == request.auth.uid
        && request.resource.data.rootItemId == householdId
        && request.resource.data.createdAt == request.time
        && isMemberAfter(householdId)
        && existsAfter(rootItemPath(householdId));
    }

    function validRootItemCreate(householdId, itemId) {
      let household = getAfter(householdPath(householdId)).data;
      return itemId == householdId
        && request.resource.data.keys().hasOnly([
          'householdId', 'name', 'parentItemId', 'photoUrl', 'description',
          'tags', 'createdAt', 'updatedAt', 'createdById',
          'createdByDisplayName', 'updatedById', 'updatedByDisplayName'
        ])
        && request.resource.data.householdId == householdId
        && request.resource.data.name == household.name
        && request.resource.data.parentItemId == null
        && request.resource.data.photoUrl == null
        && request.resource.data.description == null
        && request.resource.data.tags is list
        && request.resource.data.tags.size() == 0
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.createdById == request.auth.uid
        && request.resource.data.createdByDisplayName is string
        && request.resource.data.updatedById == request.auth.uid
        && request.resource.data.updatedByDisplayName
          == request.resource.data.createdByDisplayName
        && isMemberAfter(householdId);
    }

    match /memberships/{memberId} {
      allow read: if signedIn() && request.auth.uid == memberId;
      allow create: if signedIn()
        && request.auth.uid == memberId
        && request.resource.data.keys().hasOnly(['householdId', 'role'])
        && request.resource.data.householdId is string
        && request.resource.data.role == 'owner'
        && getAfter(householdPath(request.resource.data.householdId))
          .data.ownerMemberId == memberId
        && existsAfter(rootItemPath(request.resource.data.householdId));
      allow update, delete: if false;
    }

    match /invitations/{invitationId} {
      allow read: if isOwner(resource.data.householdId);
      allow create: if signedIn() && validInvitationCreate(invitationId);
      allow update: if signedIn()
        && (
          validInvitationRevoke()
          || validInvitationExpire()
          || validInvitationReplace(invitationId)
        );
      allow delete: if false;
    }

    match /households/{householdId} {
      allow read: if isMember(householdId);
      allow create: if signedIn() && validHouseholdCreate(householdId);
      allow update, delete: if false;

      match /items/{itemId} {
        allow read: if isMember(householdId);
        allow create: if signedIn()
          && validRootItemCreate(householdId, itemId);
        allow update, delete: if false;
      }
    }
  }
}
