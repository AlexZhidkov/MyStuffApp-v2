rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function membershipPath(memberId) {
      return /databases/$(database)/documents/memberships/$(memberId);
    }

    function householdPath(householdId) {
      return /databases/$(database)/documents/households/$(householdId);
    }

    function rootItemPath(householdId) {
      return /databases/$(database)/documents/households/$(householdId)/items/$(householdId);
    }

    function itemPath(householdId, itemId) {
      return /databases/$(database)/documents/households/$(householdId)/items/$(itemId);
    }

    function itemAttachmentPath(householdId, itemId, attachmentId) {
      return /databases/$(database)/documents/households/$(householdId)/items/$(itemId)/attachments/$(attachmentId);
    }

    function invitationPath(invitationId) {
      return /databases/$(database)/documents/invitations/$(invitationId);
    }

    function invitationDraftPath(invitationId) {
      return /databases/$(database)/documents/invitationDrafts/$(invitationId);
    }

    function isMember(householdId) {
      return signedIn()
        && get(membershipPath(request.auth.uid)).data.householdId == householdId;
    }

    function isMemberAfter(householdId) {
      return signedIn()
        && getAfter(membershipPath(request.auth.uid)).data.householdId == householdId;
    }

    function isOwner(householdId) {
      return isMember(householdId)
        && get(householdPath(householdId)).data.ownerMemberId == request.auth.uid;
    }

    function validInvitationDraftCreate() {
      return request.resource.data.keys().hasOnly([
          'householdId', 'intendedEmail', 'createdAt', 'replacesInvitationId'
        ])
        && request.resource.data.householdId is string
        && request.resource.data.intendedEmail is string
        && request.resource.data.intendedEmail.matches(
          '^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$'
        )
        && request.resource.data.createdAt == request.time
        && (
          request.resource.data.replacesInvitationId == null
          || validReplacementDraftCreate()
        )
        && isOwner(request.resource.data.householdId);
    }

    function validReplacementDraftCreate() {
      let previousId = request.resource.data.replacesInvitationId;
      let previous = get(invitationPath(previousId)).data;
      return previousId is string
        && previous.status == 'pending'
        && previous.expiresAt > request.time
        && previous.householdId == request.resource.data.householdId;
    }

    function validInvitationCreate(invitationId) {
      let draft = get(invitationDraftPath(invitationId)).data;
      return request.resource.data.keys().hasOnly([
          'householdId', 'intendedEmail', 'createdAt', 'expiresAt', 'status',
          'replacesInvitationId', 'replacedByInvitationId'
        ])
        && request.resource.data.householdId == draft.householdId
        && request.resource.data.intendedEmail == draft.intendedEmail
        && request.resource.data.createdAt == draft.createdAt
        && request.resource.data.expiresAt
          == draft.createdAt + duration.value(7, 'd')
        && request.resource.data.status == 'pending'
        && request.resource.data.replacesInvitationId
          == draft.replacesInvitationId
        && request.resource.data.replacedByInvitationId == null
        && !existsAfter(invitationDraftPath(invitationId))
        && (
          draft.replacesInvitationId == null
          || validReplacementCreate(invitationId)
        )
        && isOwner(draft.householdId);
    }

    function validReplacementCreate(invitationId) {
      let previousId = request.resource.data.replacesInvitationId;
      let previous = get(invitationPath(previousId)).data;
      let previousAfter = getAfter(invitationPath(previousId)).data;
      return previous.status == 'pending'
        && previous.expiresAt > request.time
        && previous.householdId == request.resource.data.householdId
        && previousAfter.status == 'replaced'
        && previousAfter.replacedByInvitationId == invitationId;
    }

    function validInvitationRevoke() {
      return resource.data.status == 'pending'
        && resource.data.expiresAt > request.time
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status'])
        && request.resource.data.status == 'revoked'
        && isOwner(resource.data.householdId);
    }

    function validInvitationReplace(invitationId) {
      let replacementId = request.resource.data.replacedByInvitationId;
      let replacement = getAfter(invitationPath(replacementId)).data;
      return resource.data.status == 'pending'
        && resource.data.expiresAt > request.time
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'replacedByInvitationId'])
        && request.resource.data.status == 'replaced'
        && replacementId is string
        && replacement.status == 'pending'
        && replacement.replacesInvitationId == invitationId
        && replacement.householdId == resource.data.householdId
        && isOwner(resource.data.householdId);
    }

    function validName(name) {
      return name is string
        && name.matches('^[^\\s\\p{Z}](.{0,98}[^\\s\\p{Z}])?$');
    }

    function validPhotoLocations(data) {
      return (
        data.get('photoAttachmentId', null) == null
        && data.get('photoUrl', null) == null
        && data.get('photoThumbnailUrl', null) == null
      ) || (
        data.photoAttachmentId is string
        && data.photoUrl is string
        && data.photoThumbnailUrl is string
      );
    }

    function validItemPhotoProjection(householdId, itemId, data) {
      return validPhotoLocations(data)
        && (
          data.get('photoAttachmentId', null) == null
          || (
            data.photoAttachmentId is string
            && exists(itemAttachmentPath(householdId, itemId, data.photoAttachmentId))
            && get(itemAttachmentPath(householdId, itemId, data.photoAttachmentId)).data.displayUrl
              == data.photoUrl
          )
        );
    }

    function validNewItemPhotoProjection(data) {
      return data.get('photoAttachmentId', null) == null
        && data.get('photoUrl', null) == null
        && data.get('photoThumbnailUrl', null) == null;
    }

    function isNonRootItemInHousehold(householdId, itemId) {
      return itemId != householdId
        && exists(itemPath(householdId, itemId))
        && get(itemPath(householdId, itemId)).data.get('householdId', null)
          == householdId
        && get(itemPath(householdId, itemId)).data.get('parentItemId', null)
          is string;
    }

    function validItemAttachmentCreate(householdId, itemId, attachmentId) {
      return isMember(householdId)
        && isNonRootItemInHousehold(householdId, itemId)
        && request.resource.data.keys().hasOnly([
          'createdAt', 'creationOrder', 'contentType', 'displayUrl'
        ])
        && request.resource.data.createdAt == request.time
        && (
          request.resource.data.get('creationOrder', null) == null
          || request.resource.data.creationOrder is int
        )
        && request.resource.data.contentType == 'image/webp'
        && request.resource.data.displayUrl is string
        && request.resource.data.displayUrl.matches(
          '^gs://[^/]+/households/' + householdId + '/items/' + itemId
            + '/attachments/' + attachmentId + '\\.webp$'
        );
    }

    function validDescription(description) {
      return description == null
        || (
          description is string
          && description.matches('^(.|\\n){0,1000}(.|\\n){0,1000}$')
        );
    }

    function validWebUrl(webUrl) {
      return webUrl == null
        || (
          webUrl is string
          && webUrl.matches(
            '^https?://[^\\s]{1,1000}[^\\s]{0,1000}[^\\s]{0,40}$'
          )
        );
    }

    function validTag(tag) {
      return tag is string
        && tag.matches('^[^\\s\\p{Z}](.{0,38}[^\\s\\p{Z}])?$');
    }

    function validTags(tags) {
      return tags is list
        && tags.size() <= 20
        && tags.toSet().size() == tags.size()
        && (tags.size() < 1 || validTag(tags[0]))
        && (tags.size() < 2 || validTag(tags[1]))
        && (tags.size() < 3 || validTag(tags[2]))
        && (tags.size() < 4 || validTag(tags[3]))
        && (tags.size() < 5 || validTag(tags[4]))
        && (tags.size() < 6 || validTag(tags[5]))
        && (tags.size() < 7 || validTag(tags[6]))
        && (tags.size() < 8 || validTag(tags[7]))
        && (tags.size() < 9 || validTag(tags[8]))
        && (tags.size() < 10 || validTag(tags[9]))
        && (tags.size() < 11 || validTag(tags[10]))
        && (tags.size() < 12 || validTag(tags[11]))
        && (tags.size() < 13 || validTag(tags[12]))
        && (tags.size() < 14 || validTag(tags[13]))
        && (tags.size() < 15 || validTag(tags[14]))
        && (tags.size() < 16 || validTag(tags[15]))
        && (tags.size() < 17 || validTag(tags[16]))
        && (tags.size() < 18 || validTag(tags[17]))
        && (tags.size() < 19 || validTag(tags[18]))
        && (tags.size() < 20 || validTag(tags[19]));
    }

    function validHouseholdCreate(householdId) {
      return request.resource.data.keys().hasOnly([
          'name', 'ownerMemberId', 'rootItemId', 'createdAt'
        ])
        && validName(request.resource.data.name)
        && request.resource.data.ownerMemberId == request.auth.uid
        && request.resource.data.rootItemId == householdId
        && request.resource.data.createdAt == request.time
        && isMemberAfter(householdId)
        && existsAfter(rootItemPath(householdId));
    }

    function validRootItemCreate(householdId, itemId) {
      let household = getAfter(householdPath(householdId)).data;
      return itemId == householdId
        && request.resource.data.keys().hasOnly([
          'householdId', 'name', 'parentItemId', 'photoAttachmentId', 'photoUrl',
          'photoThumbnailUrl', 'description', 'tags', 'createdAt',
          'webUrl',
          'updatedAt', 'createdById',
          'createdByDisplayName', 'updatedById', 'updatedByDisplayName'
        ])
        && request.resource.data.householdId == householdId
        && request.resource.data.name == household.name
        && request.resource.data.parentItemId == null
        && request.resource.data.get('photoAttachmentId', null) == null
        && request.resource.data.get('photoUrl', null) == null
        && request.resource.data.get('photoThumbnailUrl', null) == null
        && request.resource.data.description == null
        && request.resource.data.get('webUrl', null) == null
        && request.resource.data.tags is list
        && request.resource.data.tags.size() == 0
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.createdById == request.auth.uid
        && request.resource.data.createdByDisplayName is string
        && request.resource.data.updatedById == request.auth.uid
        && request.resource.data.updatedByDisplayName
          == request.resource.data.createdByDisplayName
        && isMemberAfter(householdId);
    }

    function validChildItemCreate(householdId, itemId) {
      return itemId != householdId
        && request.resource.data.keys().hasOnly([
          'householdId', 'name', 'parentItemId', 'photoAttachmentId', 'photoUrl',
          'photoThumbnailUrl', 'description', 'tags', 'createdAt',
          'webUrl',
          'updatedAt', 'createdById',
          'createdByDisplayName', 'updatedById', 'updatedByDisplayName'
        ])
        && request.resource.data.householdId == householdId
        && validName(request.resource.data.name)
        && request.resource.data.parentItemId is string
        && exists(itemPath(householdId, request.resource.data.parentItemId))
        && validNewItemPhotoProjection(request.resource.data)
        && validDescription(request.resource.data.description)
        && validWebUrl(request.resource.data.get('webUrl', null))
        && validTags(request.resource.data.tags)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.createdById == request.auth.uid
        && request.resource.data.createdByDisplayName is string
        && request.resource.data.updatedById == request.auth.uid
        && request.resource.data.updatedByDisplayName
          == request.resource.data.createdByDisplayName
        && isMember(householdId);
    }

    function validChildItemUpdate(householdId, itemId) {
      return itemId != householdId
        && resource.data.get('householdId', null) == householdId
        && resource.data.parentItemId is string
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'photoAttachmentId', 'photoUrl', 'photoThumbnailUrl', 'description', 'tags',
          'webUrl',
          'updatedAt', 'updatedById', 'updatedByDisplayName'
        ])
        && validName(request.resource.data.name)
        && request.resource.data.parentItemId is string
        && request.resource.data.parentItemId != itemId
        && exists(itemPath(householdId, request.resource.data.parentItemId))
        && get(itemPath(householdId, request.resource.data.parentItemId)).data.householdId
          == householdId
        && validItemPhotoProjection(householdId, itemId, request.resource.data)
        && validDescription(request.resource.data.description)
        && validWebUrl(request.resource.data.get('webUrl', null))
        && validTags(request.resource.data.tags)
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedById == request.auth.uid
        && request.resource.data.updatedByDisplayName is string
        && isMember(householdId);
    }

    match /memberships/{memberId} {
      allow read: if signedIn() && request.auth.uid == memberId;
      allow create: if signedIn()
        && request.auth.uid == memberId
        && request.resource.data.keys().hasOnly(['householdId', 'role'])
        && request.resource.data.householdId is string
        && request.resource.data.role == 'owner'
        && getAfter(householdPath(request.resource.data.householdId))
          .data.ownerMemberId == memberId
        && existsAfter(rootItemPath(request.resource.data.householdId));
      allow update, delete: if false;
    }

    match /invitations/{invitationId} {
      allow read: if isOwner(resource.data.householdId);
      allow create: if signedIn() && validInvitationCreate(invitationId);
      allow update: if signedIn()
        && (
          validInvitationRevoke()
          || validInvitationReplace(invitationId)
        );
      allow delete: if false;
    }

    match /invitationDrafts/{invitationId} {
      allow read: if isOwner(resource.data.householdId);
      allow create: if signedIn() && validInvitationDraftCreate();
      allow update: if false;
      allow delete: if isOwner(resource.data.householdId);
    }

    match /households/{householdId} {
      allow read: if isMember(householdId);
      allow create: if signedIn() && validHouseholdCreate(householdId);
      allow update, delete: if false;

      match /items/{itemId} {
        allow read: if isMember(householdId);
        allow create: if signedIn()
          && (
            validRootItemCreate(householdId, itemId)
            || validChildItemCreate(householdId, itemId)
          );
        allow update: if signedIn()
          && validChildItemUpdate(householdId, itemId);
        allow delete: if false;
      }

      match /searchIndex/{itemId} {
        allow read, write: if false;
      }

      match /items/{itemId}/attachments/{attachmentId} {
        allow read: if isMember(householdId)
          && isNonRootItemInHousehold(householdId, itemId);
        allow create: if signedIn()
          && validItemAttachmentCreate(householdId, itemId, attachmentId);
        allow delete: if isMember(householdId)
          && isNonRootItemInHousehold(householdId, itemId);
        allow update: if false;
      }
    }
  }
}
