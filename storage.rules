rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function householdPath(householdId) {
      return /databases/(default)/documents/households/$(householdId);
    }

    function itemPath(householdId, itemId) {
      return /databases/(default)/documents/households/$(householdId)/items/$(itemId);
    }

    function isActiveStorageMember(householdId) {
      // Keep this projection in the Household document: Storage rules may read
      // at most two Firestore documents, including the Item lookup below.
      let household = firestore.get(householdPath(householdId));
      return request.auth != null
        && household.data.get('storageAccessRevoked', true) == false
        && household.data.get('storageMemberIds', {}).get(request.auth.uid, false) == true;
    }

    function isFullItemPhoto(fileName) {
      return fileName.matches('^[A-Za-z0-9_-]+\\.webp$')
        && !fileName.matches('^.*-thumb\\.webp$');
    }

    function isItemPhotoThumbnail(fileName) {
      return fileName.matches('^[A-Za-z0-9_-]+-thumb\\.webp$');
    }

    function isItemPhoto(fileName) {
      return isFullItemPhoto(fileName) || isItemPhotoThumbnail(fileName);
    }

    function isNonRootItemInHousehold(householdId, itemId) {
      let item = firestore.get(itemPath(householdId, itemId));
      return itemId != householdId
        && item.data.get('householdId', null) == householdId
        && item.data.get('parentItemId', null) is string;
    }

    function isItemAttachmentThumbnail(fileName) {
      return fileName.matches('^[A-Za-z0-9_-]+-thumb\\.webp$');
    }

    function isItemAttachmentFull(fileName) {
      return fileName.matches('^[A-Za-z0-9_-]+\\.webp$')
        && !isItemAttachmentThumbnail(fileName);
    }

    function isItemAttachmentFile(fileName) {
      return isItemAttachmentFull(fileName) || isItemAttachmentThumbnail(fileName);
    }

    match /households/{householdId}/items/{fileName} {
      allow read, delete: if isActiveStorageMember(householdId) && isItemPhoto(fileName);
      // Flat Item Photo objects are legacy data. New clients must write the
      // nested Item Attachment location below, but migrated references remain
      // readable and removable.
    }

    match /households/{householdId}/items/{itemId}/attachments/{fileName} {
      allow read, delete: if isActiveStorageMember(householdId)
        && isNonRootItemInHousehold(householdId, itemId)
        && isItemAttachmentFile(fileName);
      // Updates keep retries idempotent; the Firestore attachment record is immutable.
      allow create, update: if isActiveStorageMember(householdId)
        && isNonRootItemInHousehold(householdId, itemId)
        && isItemAttachmentFile(fileName)
        && request.resource.contentType == 'image/webp'
        && (
          (isItemAttachmentFull(fileName) && request.resource.size <= 2 * 1024 * 1024)
          || (
            isItemAttachmentThumbnail(fileName)
            && request.resource.size <= 256 * 1024
          )
        );
    }
  }
}
