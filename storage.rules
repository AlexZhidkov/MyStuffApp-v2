rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isMember(householdId) {
      return request.auth != null
        && firestore.exists(
          /databases/(default)/documents/memberships/$(request.auth.uid)
        )
        && firestore.get(
          /databases/(default)/documents/memberships/$(request.auth.uid)
        ).data.householdId == householdId;
    }

    function isFullItemPhoto(fileName) {
      return fileName.matches('^[A-Za-z0-9_-]+\\.webp$')
        && !fileName.matches('^.*-thumb\\.webp$');
    }

    function isItemPhotoThumbnail(fileName) {
      return fileName.matches('^[A-Za-z0-9_-]+-thumb\\.webp$');
    }

    function isItemPhoto(fileName) {
      return isFullItemPhoto(fileName) || isItemPhotoThumbnail(fileName);
    }

    function isNonRootItemInHousehold(householdId, itemId) {
      return itemId != householdId
        && firestore.exists(
          /databases/(default)/documents/households/$(householdId)/items/$(itemId)
        )
        && firestore.get(
          /databases/(default)/documents/households/$(householdId)/items/$(itemId)
        ).data.get('householdId', null) == householdId
        && firestore.get(
          /databases/(default)/documents/households/$(householdId)/items/$(itemId)
        ).data.get('parentItemId', null) is string;
    }

    function isItemAttachmentThumbnail(fileName) {
      return fileName.matches('^[A-Za-z0-9_-]+-thumb\\.webp$');
    }

    function isItemAttachmentFull(fileName) {
      return fileName.matches('^[A-Za-z0-9_-]+\\.webp$')
        && !isItemAttachmentThumbnail(fileName);
    }

    function isItemAttachmentFile(fileName) {
      return isItemAttachmentFull(fileName) || isItemAttachmentThumbnail(fileName);
    }

    match /households/{householdId}/items/{fileName} {
      allow read, delete: if isMember(householdId) && isItemPhoto(fileName);
      allow create, update: if isMember(householdId)
        && request.resource.contentType == 'image/webp'
        && (
          (isFullItemPhoto(fileName) && request.resource.size <= 2 * 1024 * 1024)
          || (
            isItemPhotoThumbnail(fileName)
            && request.resource.size <= 256 * 1024
          )
      );
    }

    match /households/{householdId}/items/{itemId}/attachments/{fileName} {
      allow read, delete: if isMember(householdId)
        && isNonRootItemInHousehold(householdId, itemId)
        && isItemAttachmentFile(fileName);
      // Updates keep retries idempotent; the Firestore attachment record is immutable.
      allow create, update: if isMember(householdId)
        && isNonRootItemInHousehold(householdId, itemId)
        && isItemAttachmentFile(fileName)
        && request.resource.contentType == 'image/webp'
        && (
          (isItemAttachmentFull(fileName) && request.resource.size <= 2 * 1024 * 1024)
          || (
            isItemAttachmentThumbnail(fileName)
            && request.resource.size <= 256 * 1024
          )
        );
    }
  }
}
